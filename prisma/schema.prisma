generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  MEMBER
}

// Колонка канбана. Список, названия, цвета и порядок редактирует админ.
model Stage {
  id        String        @id @default(cuid())
  name      String
  color     String        @default("#64748b")
  sortOrder Int
  apps      App[]
  fromLinks StageChange[] @relation("fromStage")
  toLinks   StageChange[] @relation("toStage")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  role         Role          @default(MEMBER)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  stageChanges StageChange[]
}

model App {
  id               String            @id @default(cuid())
  bundleId         String?
  storeUrl         String?
  developerAccount String?
  notes            String?
  iconPath         String?
  primaryLocale    String            @default("en-US")
  stageId          String
  stage            Stage             @relation(fields: [stageId], references: [id], onDelete: Restrict)
  position         Float             @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  localizations    Localization[]
  screenshots      Screenshot[]
  localeShots      LocaleScreenshot[]
  stageChanges     StageChange[]

  @@index([stageId, position])
}

model Localization {
  id          String   @id @default(cuid())
  appId       String
  app         App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  locale      String
  title       String   @default("")
  subtitle    String   @default("")
  promoText   String   @default("")
  description String   @default("")
  keywords    String   @default("")
  whatsNew    String   @default("")
  // Заполнено автопереводом и ещё не проверено человеком
  autoTranslated Boolean @default(false)
  updatedAt   DateTime @updatedAt

  @@unique([appId, locale])
}

// Загруженный файл скриншота (библиотека приложения)
model Screenshot {
  id           String             @id @default(cuid())
  appId        String
  app          App                @relation(fields: [appId], references: [id], onDelete: Cascade)
  path         String
  originalName String
  createdAt    DateTime           @default(now())
  placements   LocaleScreenshot[]
}

// Порядок скриншотов в конкретной локали
model LocaleScreenshot {
  id           String     @id @default(cuid())
  appId        String
  app          App        @relation(fields: [appId], references: [id], onDelete: Cascade)
  locale       String
  screenshotId String
  screenshot   Screenshot @relation(fields: [screenshotId], references: [id], onDelete: Cascade)
  sortOrder    Int

  @@unique([appId, locale, sortOrder])
  @@index([appId, locale])
}

model StageChange {
  id        String   @id @default(cuid())
  appId     String
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  // Название этапа сохраняется на момент перехода, чтобы история не ломалась при переименовании или удалении
  fromStageId   String?
  fromStage     Stage?   @relation("fromStage", fields: [fromStageId], references: [id], onDelete: SetNull)
  fromStageName String?
  toStageId     String?
  toStage       Stage?   @relation("toStage", fields: [toStageId], references: [id], onDelete: SetNull)
  toStageName   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([appId, createdAt])
}
